# ===================================
# STYLELINK SAAS - CONFIGURAÇÃO
# ===================================

# Servidor
PORT=3000
NODE_ENV=development

# URLs do Frontend
FRONTEND_ADMIN_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:8081

# URL do Backend (para webhooks)
BACKEND_URL=http://localhost:3000

# ===================================
# BANCO DE DADOS POSTGRESQL
# ===================================
# Formato: postgresql://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/stylelink

# ===================================
# JWT (JSON Web Token)
# ===================================
# Gere uma chave secreta forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_secreta_aqui_mude_isso

# ===================================
# CLOUDINARY (Upload de Imagens)
# ===================================
# Crie uma conta em: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ===================================
# EMAIL (SMTP)
# ===================================
# Para Gmail: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app

# ===================================
# MERCADO PAGO (Pagamentos)
# ===================================
# Pegue suas credenciais em: https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui

# Para testes, use:
# MERCADOPAGO_ACCESS_TOKEN=TEST-seu_token_de_teste
