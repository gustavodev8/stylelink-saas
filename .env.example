# ===================================
# STYLELINK SAAS - CONFIGURAÇÃO RAILWAY
# ===================================

# Servidor
PORT=3000
NODE_ENV=production

# URLs do Frontend (Substitua pelo seu domínio Railway)
FRONTEND_ADMIN_URL=https://seu-app.railway.app
FRONTEND_PUBLIC_URL=https://seu-app.railway.app

# URL do Backend (será preenchida automaticamente pelo Railway)
BACKEND_URL=https://seu-app.railway.app

# ===================================
# BANCO DE DADOS POSTGRESQL
# ===================================
# No Railway, adicione um PostgreSQL Plugin
# A variável DATABASE_URL será preenchida automaticamente
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ===================================
# JWT (JSON Web Token)
# ===================================
# Gere uma chave secreta forte com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cole_aqui_uma_chave_secreta_forte_de_64_caracteres

# ===================================
# CLOUDINARY (Upload de Imagens)
# ===================================
# Crie uma conta GRATUITA em: https://cloudinary.com
# 1. Acesse https://cloudinary.com/users/register/free
# 2. Após login, copie as credenciais do Dashboard
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ===================================
# EMAIL (SMTP)
# ===================================
# Gmail: https://support.google.com/accounts/answer/185833
# Ou use serviços gratuitos: SendGrid, Mailgun, Brevo (ex-Sendinblue)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app

# ===================================
# MERCADO PAGO (Pagamentos) - OPCIONAL
# ===================================
# Pegue suas credenciais em: https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui

# Para testes, use:
# MERCADOPAGO_ACCESS_TOKEN=TEST-seu_token_de_teste
